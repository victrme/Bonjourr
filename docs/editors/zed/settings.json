{
    "formatter": "language_server",
    "tab_size": 4,
    "languages": {
        "JavaScript": {
            "language_servers": [
                "deno",
                "!vtsls",
                "!typescript-language-server",
                "!biome"
            ],
            "formatter": "language_server",
            "tab_size": 4
        },
        "TypeScript": {
            "language_servers": [
                "deno",
                "!vtsls",
                "!typescript-language-server",
                "!biome"
            ],
            "formatter": "language_server",
            "tab_size": 4
        },
        "HTML": {
            "language_servers": [
                "!vscode-html-language-server"
            ]
        },
        "CSS": {
            "language_servers": [
                "!vscode-css-language-server"
            ]
        },
        "JSON": {
            "language_servers": [
                "json-language-server"
            ],
            "formatter": "prettier",
            "tab_size": 4
        }
    }
}
